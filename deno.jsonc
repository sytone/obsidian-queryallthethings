{
  "tasks": {
    "dev": "deno run -A scripts/build.ts dev",
    "build": "deno run -A scripts/build.ts production",
    "test": "deno test -A --allow-read --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "bump": "deno run -A scripts/version-bump.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/", "scripts/", "tests/"]
  },
  "lint": {
    "include": ["src/", "scripts/", "tests/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "imports": {
    "obsidian": "npm:obsidian@^1.7.2",
    "alasql": "npm:alasql@^4.4.0",
    "eventemitter2": "npm:eventemitter2@^6.4.9",
    "handlebars": "npm:handlebars@^4.7.8",
    "luxon": "npm:luxon@^3.4.4",
    "mdast-util-from-markdown": "npm:mdast-util-from-markdown@^1.3.1",
    "mdast-util-to-string": "npm:mdast-util-to-string@^3.2.0",
    "mdast-util-wiki-link": "npm:mdast-util-wiki-link@^0.0.2",
    "micromark": "npm:micromark@^3.2.0",
    "micromark-extension-gfm": "npm:micromark-extension-gfm@^2.0.3",
    "micromark-extension-gfm-footnote": "npm:micromark-extension-gfm-footnote@^1.1.2",
    "micromark-extension-gfm-task-list-item": "npm:micromark-extension-gfm-task-list-item@^1.0.5",
    "micromark-extension-math": "npm:micromark-extension-math@^2.1.2",
    "micromark-extension-wiki-link": "npm:micromark-extension-wiki-link@^0.0.4",
    "micromark-util-combine-extensions": "npm:micromark-util-combine-extensions@^1.1.0",
    "micromark-util-types": "npm:micromark-util-types@^1.1.0",
    "p-debounce": "npm:p-debounce@^4.0.0",
    "papaparse": "npm:papaparse@^5.4.1",
    "esbuild": "npm:esbuild@^0.18.5",
    "js-yaml": "npm:js-yaml@^4.1.0",
    "@types/luxon": "npm:@types/luxon@^3.4.2",
    "@types/papaparse": "npm:@types/papaparse@^5.3.14",
    "@ophidian/core": "npm:@ophidian/core@^0.0.21",
    "@codemirror/state": "npm:@codemirror/state@^6.4.1",
    "@codemirror/view": "npm:@codemirror/view@^6.28.2",
    "@preact/signals-core": "npm:@preact/signals-core@^1.6.1",
    "lib/": "./src/lib/",
    "Settings/": "./src/Settings/",
    "Query/": "./src/Query/",
    "Render/": "./src/Render/",
    "Data/": "./src/Data/",
    "Integrations/": "./src/Integrations/",
    "Interfaces/": "./src/Interfaces/",
    "Parse/": "./src/Parse/",
    "PostRender/": "./src/PostRender/",
    "handlers/": "./src/handlers/",
    "UI/": "./src/UI/",
    "typings/": "./src/typings/",
    "Internal.ts": "./src/Internal.ts",
    "ListItem.ts": "./src/ListItem.ts",
    "Note.ts": "./src/Note.ts",
    "NotesCacheService.ts": "./src/NotesCacheService.ts",
    "QattCodeBlock.ts": "./src/QattCodeBlock.ts",
    "QueryRenderChildV2.ts": "./src/QueryRenderChildV2.ts",
    "QueryRenderChildV3.ts": "./src/QueryRenderChildV3.ts",
    "QueryRendererV2Service.ts": "./src/QueryRendererV2Service.ts",
    "ReleaseNotes.ts": "./src/ReleaseNotes.ts",
    "TaskItem.ts": "./src/TaskItem.ts"
  }
}
